doctype html
html(lang="vi")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title= title || 'Hệ thống Tuyển dụng IT'
        link(rel="stylesheet", href="/css/base.css")
        link(rel="stylesheet", href="/css/navbar.css")    

        block styles
    body 
        header.navbar
            .logo
                a(href="/") IT-Recruitment 
            
            //- Menu phải nằm trong header để dàn ngang với logo
            if user
                nav.menu 
                    a(href="/") Trang chủ
                    a(href="/dashboard") Trang cá nhân 
                    a(href="/auth/logout" style="color: #ef4444;") Đăng xuất
            else
                nav.menu 
                    a(href="/") Trang chủ
                    a(href="/auth/login") Đăng nhập 
                    a(href="/auth/register") Đăng ký

        main.container
            block content

        footer.footer 
            p © 2026 Hệ thống Tuyển dụng IT