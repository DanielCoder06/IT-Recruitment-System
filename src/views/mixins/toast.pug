mixin toast(message, type)
    if message
        div#toast-message.toast-message(class=(type === 'error' ? 'toast-error' : 'toast-success'))
            if type === 'error'
                svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#ef4444" width="24" height="24")
                    circle(cx="12" cy="12" r="12")
                    path(d="M15 9l-6 6m0-6l6 6" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none")
            else
                svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#10b981" width="24" height="24")
                    circle(cx="12" cy="12" r="12")
                    path(d="M17.5 7.5L10 15L6.5 11.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none")
            
            span= message