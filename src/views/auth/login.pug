extends ../layouts/main.pug

block styles
  link(rel="stylesheet", href="/css/form.css")

block content
    .form-container
        h2 Đăng nhập tài khoản 

        if error 
           p.error-msg(style="color: red; margin-bottom: 15px; text-align: center;")= error

        form(action="/auth/login" method="POST" autocomplete="off")
            .form-group 
                label Email
                input(type="email" name="email" required placeholder="Nhập email...")
                label Mật khẩu
                input(type="password" name="password" require placeholder="Nhập mật khẩu...")
            button.btn(type="submit") Đăng nhập

        p(style="text-align: center; margin-top: 15px;")
            | Chưa có tài khoản? 
            a(href="/auth/register") Đăng ký ngay