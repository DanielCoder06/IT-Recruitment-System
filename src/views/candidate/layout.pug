doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= title
    //- Thêm Base CSS
    link(rel="stylesheet", href="/css/base.css")
    link(rel="stylesheet", href="/css/candidate.css")
    block styles
  body
    .candidate-layout
      //- ... (phần Topbar, Sidebar giữ nguyên)
      header.topbar
        .logo IT Recruitment Candidate
        .user-actions
          a(href="/candidate/profile") Hồ sơ cá nhân
          a.btn-logout(href="/auth/logout") Đăng xuất
        
      .body-wrapper
        aside.sidebar
          ul.menu
            li 
              a(href="/candidate/dashboard" class=(currentPath === '/candidate/dashboard' ? 'active' : '')) Tổng quan
            li 
              a(href="/jobs" class=(currentPath.startsWith('/jobs') ? 'active' : '')) Tìm việc làm
            li 
              a(href="/candidate/applications" class=(currentPath === '/candidate/applications' ? 'active' : '')) Việc đã ứng tuyển
        main.main-content
          block content
          
    //- Thêm block scripts cho Candidate
    block scripts