extends ./layout.pug

//- Include Mixin
include ../mixins/toast.pug

block styles
  link(rel="stylesheet", href="/css/job.css")

block content   
    //- Gọi Mixin Toast
    if success 
        - const msg = success === 'updated' ? 'Cập nhật bài đăng thành công!' : 'Xóa bài đăng thành công!'
        +toast(msg, 'success')

    .page-header
        h1.page-title Quản lý bài đăng tuyển dụng
        a.btn-primary(href="/company/jobs/create") + Đăng bài mới

    .table-container
        table 
            thead
                tr
                    th Tiêu đề
                    th Mức lương
                    th Ngày đăng
                    th Trạng thái
                    th Hành động
            tbody 
                if jobs.length === 0
                    tr
                        td.empty-state(colspan="5")
                            | Bạn chưa có bài đăng tuyển dụng nào. Hãy bấm "Đăng bài mới" để bắt đầu!
                else 
                    each job in jobs
                        tr 
                            td
                                a.job-title-link(href=`/company/jobs/${job.id}`)= job.title
                            td= job.salary
                            td= job.createdAt.toLocaleDateString('vi-VN')
                            td 
                                if job.status === 'PUBLISHED'
                                    span.badge.badge-accepted Đang tuyển 
                                else
                                    span.badge.badge-pending Bản nháp
                            td.action-links
                                a.btn-view(href=`/company/jobs/${job.id}`) Xem
                                a.btn-edit(href=`/company/jobs/${job.id}/edit`) Sửa
                                form.delete-form(action=`/company/jobs/${job.id}/delete` method="POST")
                                    button.btn-delete(type="submit") Xóa

//- Nhúng file JS
block scripts
    script(src="/js/jobs.js")
    script(src="/js/toast.js")