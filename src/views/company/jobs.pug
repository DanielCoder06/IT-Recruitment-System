extends ./layout.pug

block styles
    link(rel="stylesheet", href="/css/job.css")
block content   
    .page-header
        h1.page-title Quản lý bài đăng tuyển dụng
        a.btn-primary(href="/company/jobs/create") + Đăng bài mới

    .table-container
        table 
            thead
                tr
                    th Tiêu đề
                    th Mức lương
                    th Trạng thái
                    th Hành động
            tbody 
                if jobs.length === 0
                    tr
                        td.empty-state(colspan="4")
                            | Bạn chưa có bài đăng tuyển dụng nào. Hãy bấm "Đăng bài mới" để bắt đầu!
                else 
                    each job in jobs
                        tr 
                            td
                                a.job-title-link(href=`/company/jobs/${job.id}`)= job.title
                            td= job.salary
                            td 
                                if job.status === 'PUBLISHED'
                                    span.status-badge.status-published Đang tuyển 
                                else
                                    span.status-badge.status-draft Bản nháp
                            td.action-links
                                a.btn-view(href=`/company/jobs/${job.id}` style="color: #007bff; margin-right: 10px;")
                                    | Xem
                                a.btn-edit(href=`/company/jobs/${job.id}/edit`) Sửa
                                a.btn-delete(href="#") Xóa