extends ./layout.pug

block styles
    link(rel="stylesheet", href="/css/applications.css")

block content 
    .page-header
        h1.page-title Quản lý đơn ứng tuyển 

    .table-container
        table 
            thead
                tr
                    th Tiêu đề công việc
                    th Ngày đăng
                    th Tổng ứng viên
                    th Cập nhật mới nhất
                    th Hành động
            tbody 
                if jobs.length === 0
                    tr
                        td.empty-state(colspan="5")
                            | Mọi bài đăng của bạn chưa có người ứng tuyển
                else 
                    each job in jobs
                        tr 
                            td
                                a.job-title-link(href=`/company/jobs/${job.id}`)= job.title
                            td= job.createdAt.toLocaleDateString('vi-VN')
                            td.job-total-candidate= job._count.applications
                            td
                                if job.applications.length > 0
                                    = job.applications[0].createdAt.toLocaleDateString('vi-VN')
                                else
                                    | Chưa có
                            td.action-links
                                if job._count.applications > 0
                                    a.btn-view(href=`/company/jobs/${job.id}/applicants`) Xem danh sách
                                else
                                    span(style="color: #94a3b8;") Trống