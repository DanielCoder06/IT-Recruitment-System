doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= title
    
    link(rel="stylesheet", href="/css/base.css")
    link(rel="stylesheet", href="/css/company.css")
    
    block styles
  body
    .company-layout
      //- TOPBAR
      header.topbar
        .logo IT Recruitment Company
        .user-actions
          a(href="/company/profile") Trang cá nhân
          a.btn-logout(href="/auth/logout") Đăng xuất
        
      //- BODY WRAPPER
      .body-wrapper
        //- SIDEBAR
        aside.sidebar
          ul.menu
            li 
              a(href="/company/dashboard" class=(currentPath === '/company/dashboard' ? 'active' : '')) Tổng quan
            li 
              a(href="/company/jobs" class=(currentPath.startsWith('/company/jobs') && !currentPath.includes('/applicants') ? 'active' : '')) Quản lý bài đăng
            li 
              a(href="/company/applications" class=(currentPath.startsWith('/company/applications') || currentPath.includes('/applicants') ? 'active' : '')) Quản lý đơn ứng tuyển
            li 
              a(href="/company/profile" class=(currentPath.startsWith('/company/profile') ? 'active' : '')) Hồ sơ công ty

        //- MAIN CONTENT
        main.main-content
          block content
          
    //- 3. Khối nhúng Script dùng chung
    block scripts