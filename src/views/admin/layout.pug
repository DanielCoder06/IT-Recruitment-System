doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= title
    link(rel="stylesheet", href="/css/base.css")
    link(rel="stylesheet", href="/css/admin.css")
  body
    .admin-wrapper
      aside.sidebar
        a.brand(href="/") IT Recruitment Admin
        ul.menu
          li 
            a(href="/admin/users" class=(currentPath === '/admin/users' ? 'active' : '')) Quản lý Người dùng
          li 
            a(href="#") Quản lý Bài đăng
          li 
            a(href="#") Thống kê hệ thống
          
      .main-content
        header.topbar
          .user-info 
            | Chào, 
            strong= user ? user.role : 'Admin'
          a.logout-btn(href="/auth/logout") Đăng xuất
          
        main.content-area
          block content